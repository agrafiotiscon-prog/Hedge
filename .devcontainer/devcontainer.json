{
  "name": "AI Hedge Fund",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "bash .devcontainer/serve.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "AI Hedge Fund",
      "onAutoForward": "openBrowser"
    }
  },
  "secrets": {
    "FINANCIAL_DATASETS_API_KEY": {
      "description": "Market data for every strategy. Get a free key at financialdatasets.ai.",
      "documentationUrl": "https://financialdatasets.ai"
    },
    "ANTHROPIC_API_KEY": {
      "description": "Lets the AI investor agents (Buffett, Graham, Munger...) reason with Claude, the app's default model.",
      "documentationUrl": "https://console.anthropic.com"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
